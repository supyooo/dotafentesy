// Dota Fantasy — ER-модель (PostgreSQL). Источник: er/schema.py. Открыть: dbdiagram.io → Import → DBML

TableGroup catalog {
  teams
  players
  team_rosters
  heroes
  external_refs
}

TableGroup tournament {
  organizers
  seasons
  tournaments
  stages
  stage_groups
  tournament_teams
  series
  streams
  maps
  map_draft
  player_map_stats
}

TableGroup ingest {
  raw_payloads
  ingest_runs
  data_overrides
}

TableGroup fantasy {
  scoring_rulesets
  tournament_players
  player_prices
  player_map_points
  player_stage_points
}

TableGroup users {
  users
  auth_identities
  user_sessions
  notification_prefs
}

TableGroup lineups {
  lineups
  lineup_slots
  lineup_locks
  lineup_lock_slots
  transfers
  lineup_stage_scores
  tournament_standings
}

TableGroup social {
  mini_leagues
  mini_league_members
}

TableGroup pickem {
  pickem_questions
  pickem_answers
  pickem_results
}

TableGroup season {
  league_tiers
  season_ladders
  league_memberships
  league_rounds
  league_groups
  league_group_members
  titan_round_points
  season_titles
}

TableGroup engagement {
  achievements
  user_achievements
  trophies
  notifications
}

TableGroup b2b {
  tenants
  api_clients
  webhook_subscriptions
  webhook_deliveries
}

Table teams [note: 'Команда'] {
  id bigint [pk]
  name text [not null]
  tag text [not null, note: 'TS, PARI…']
  country_code char(2)
  logo_url text [note: 'свой файл, не логотип организатора']
  updated_at timestamptz [not null]
}

Table players [note: 'Игрок про-сцены'] {
  id bigint [pk]
  nickname text [not null, note: 'текущий ник; ники меняются — не ключ']
  real_name text
  country_code char(2)
  steam_account_id bigint [unique, note: 'account_id (Steam32) — главный ключ сопоставления']
  photo_url text
  photo_license text [note: 'источник и права на фото']
  updated_at timestamptz [not null]
}

Table team_rosters [note: 'Кто за какую команду играл и когда'] {
  id bigint [pk]
  team_id bigint [not null, ref: > teams.id]
  player_id bigint [not null, ref: > players.id]
  position smallint [note: '1–5']
  role text [not null, note: 'player | standin | coach']
  valid_from date [not null]
  valid_to date [note: 'null — состав актуален']
  indexes {
    (player_id, valid_to)
  }
}

Table heroes [note: 'Герои Dota'] {
  id smallint [pk, note: 'hero_id из игры']
  code text [not null, note: 'npc_dota_hero_…']
  name_ru text [not null]
  icon_url text
}

Table external_refs [note: 'Сопоставление с внешними источниками'] {
  id bigint [pk]
  entity_type text [not null, note: 'team | player | tournament | series | map | league']
  entity_id bigint [not null, note: 'id в нашей таблице']
  provider text [not null, note: 'liquipedia | opendota | stratz | steam | pandascore | grid']
  external_id text [not null]
  url text
  indexes {
    (provider, entity_type, external_id) [unique]
    (entity_type, entity_id)
  }
}

Table organizers [note: 'Организатор'] {
  id bigint [pk]
  name text [not null, note: 'BLAST, PGL, ESL…']
  slug text [unique]
}

Table seasons [note: 'Сезон (от TI до TI)'] {
  id bigint [pk]
  name text [not null, note: '2026/27']
  starts_on date [not null]
  ends_on date
  status text [not null, note: 'planned | active | finished']
  config jsonb [not null, note: 'зоны, размер группы, калибровка, F1-очки']
}

Table tournaments [note: 'Турнир'] {
  id bigint [pk]
  season_id bigint [ref: > seasons.id]
  organizer_id bigint [ref: > organizers.id]
  slug text [unique, note: 'blast-slam-9']
  name text [not null]
  tier smallint [not null, note: '1']
  prize_pool_usd integer
  location text
  starts_at timestamptz
  ends_at timestamptz
  status text [not null, note: 'announced | open | live | finished | cancelled']
  is_league_round boolean [not null, note: 'раунд лиги сезона']
  skin text [note: 'оформление']
  scoring_ruleset_id bigint [not null, ref: > scoring_rulesets.id, note: 'правила очков на турнир']
  config jsonb [not null, note: 'бюджет, лимиты, трансферы, пороги медалей']
}

Table stages [note: 'Стадия (окно → дедлайн → игры)'] {
  id bigint [pk]
  tournament_id bigint [not null, ref: > tournaments.id]
  idx smallint [not null, note: '0, 1, 2…']
  name text [not null]
  format text [not null, note: 'gsl | swiss | round_robin | double_elim | single_elim']
  deadline_at timestamptz [note: 'первая карта стадии']
  starts_at timestamptz
  ends_at timestamptz
  status text [not null, note: 'upcoming | open | locked | settling | settled']
  indexes {
    (tournament_id, idx) [unique]
  }
}

Table stage_groups [note: 'Группа внутри стадии'] {
  id bigint [pk]
  stage_id bigint [not null, ref: > stages.id]
  label text [not null, note: 'A, B…']
}

Table tournament_teams [note: 'Участник турнира'] {
  tournament_id bigint [ref: > tournaments.id]
  team_id bigint [ref: > teams.id]
  seed smallint
  group_id bigint [ref: > stage_groups.id]
  status text [not null, note: 'active | eliminated']
  eliminated_after_stage_id bigint [ref: > stages.id]
  final_place smallint
  indexes {
    (tournament_id, team_id) [pk]
  }
}

Table series [note: 'Серия (узел сетки)'] {
  id bigint [pk]
  tournament_id bigint [not null, ref: > tournaments.id]
  stage_id bigint [not null, ref: > stages.id]
  group_id bigint [ref: > stage_groups.id]
  round_label text [not null, note: '«Верхняя сетка · 1/4»']
  bracket_side text [note: 'group | upper | lower | final']
  round_no smallint
  slot smallint [note: 'позиция в раунде']
  best_of smallint [not null, note: '1 | 2 | 3 | 5']
  team_a_id bigint [ref: > teams.id, note: 'null — ещё не определена']
  team_b_id bigint [ref: > teams.id]
  score_a smallint [not null, note: '0']
  score_b smallint [not null, note: '0']
  winner_team_id bigint [ref: > teams.id]
  status text [not null, note: 'scheduled | live | finished | forfeit | cancelled']
  scheduled_at timestamptz
  started_at timestamptz
  finished_at timestamptz
  next_win_series_id bigint [ref: > series.id, note: 'куда идёт победитель']
  next_lose_series_id bigint [ref: > series.id, note: 'куда идёт проигравший']
  indexes {
    (tournament_id, stage_id)
    (status)
  }
}

Table streams [note: 'Трансляции'] {
  id bigint [pk]
  tournament_id bigint [not null, ref: > tournaments.id]
  series_id bigint [ref: > series.id, note: 'null — канал турнира']
  platform text [not null, note: 'twitch | youtube | vk | kick']
  url text [not null]
  language text [note: 'ru, en']
}

Table maps [note: 'Карта (одна игра серии)'] {
  id bigint [pk]
  series_id bigint [not null, ref: > series.id]
  map_no smallint [not null, note: '1…5']
  dota_match_id bigint [unique, note: 'match_id Valve; null до старта']
  radiant_team_id bigint [ref: > teams.id]
  dire_team_id bigint [ref: > teams.id]
  winner_team_id bigint [ref: > teams.id]
  duration_s integer
  started_at timestamptz
  ended_at timestamptz
  status text [not null, note: 'live | finished | void (ремейк)']
  data_tier text [not null, note: 'live | basic | parsed']
  parsed_at timestamptz
  indexes {
    (series_id, map_no) [unique]
  }
}

Table map_draft [note: 'Пики и баны карты'] {
  map_id bigint [ref: > maps.id]
  order_no smallint
  team_id bigint [not null, ref: > teams.id]
  hero_id smallint [not null, ref: > heroes.id]
  is_pick boolean [not null]
  indexes {
    (map_id, order_no) [pk]
  }
}

Table player_map_stats [note: 'Статистика игрока на карте (сырая, без очков)'] {
  map_id bigint [ref: > maps.id]
  player_id bigint [ref: > players.id]
  team_id bigint [not null, ref: > teams.id]
  hero_id smallint [ref: > heroes.id]
  is_radiant boolean [not null]
  won boolean [note: 'null пока карта идёт']
  kills smallint [not null, note: 'live']
  deaths smallint [not null, note: 'live']
  assists smallint [not null, note: 'live']
  last_hits smallint [not null, note: 'live']
  denies smallint [not null, note: 'live']
  gpm smallint [note: 'live']
  xpm smallint [note: 'live']
  net_worth integer [note: 'live']
  hero_damage integer [note: 'конец карты']
  building_damage integer [note: 'конец карты']
  hero_healing integer [note: 'конец карты']
  obs_placed smallint [note: 'после разбора']
  obs_killed smallint [note: 'после разбора']
  stun_s numeric(6,1) [note: 'после разбора']
  camps_stacked smallint [note: 'после разбора']
  data_tier text [not null, note: 'live | basic | parsed']
  extra jsonb [note: 'всё остальное из источника']
  updated_at timestamptz [not null]
  indexes {
    (map_id, player_id) [pk]
    (player_id)
  }
}

Table raw_payloads [note: 'Сырой ответ внешнего API'] {
  id bigint [pk]
  provider text [not null]
  resource text [not null, note: 'league_matches | match | live_league_games | bracket…']
  external_id text
  fetched_at timestamptz [not null, note: 'ключ партиции']
  http_status smallint
  payload jsonb [not null]
  payload_hash bytea [not null, note: 'дубликаты не пишем']
  indexes {
    (provider, resource, external_id, payload_hash, fetched_at) [unique]
  }
}

Table ingest_runs [note: 'Журнал запусков сборщиков'] {
  id bigint [pk]
  job text [not null]
  provider text [not null]
  started_at timestamptz [not null]
  finished_at timestamptz
  status text [not null, note: 'ok | partial | failed']
  items_seen integer
  items_changed integer
  error text
}

Table data_overrides [note: 'Ручные правки данных'] {
  id bigint [pk]
  entity_type text [not null, note: 'map | player_map_stats | series | tournament_players…']
  entity_id text [not null]
  field text [not null]
  value jsonb [not null]
  reason text [not null, note: 'стендин, ремейк, ошибка источника']
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null]
}

Table scoring_rulesets [note: 'Версия правил очков'] {
  id bigint [pk]
  version text [unique, note: '2026.10-a']
  rules jsonb [not null, note: 'очки за статистики']
  role_coefs jsonb [not null, note: 'множители позиций']
  published_at timestamptz
  notes text
}

Table tournament_players [note: 'Игрок в пуле турнира'] {
  id bigint [pk]
  tournament_id bigint [not null, ref: > tournaments.id]
  player_id bigint [not null, ref: > players.id]
  team_id bigint [not null, ref: > teams.id]
  position smallint [not null, note: '1–5, на турнир не меняется']
  is_active boolean [not null, note: 'false — стендин заменил / снят']
  start_rating numeric(5,2) [note: 'внутренний, не показываем']
  start_price numeric(4,1) [not null, note: '4.5–12.5']
  indexes {
    (tournament_id, player_id) [unique]
  }
}

Table player_prices [note: 'Цена на начало стадии'] {
  tournament_player_id bigint [ref: > tournament_players.id]
  stage_id bigint [ref: > stages.id]
  price numeric(4,1) [not null]
  change numeric(3,1) [not null]
  reason text [note: 'очки за карту / вылет (цена заморожена)']
  indexes {
    (tournament_player_id, stage_id) [pk]
  }
}

Table player_map_points [note: 'Очки игрока за карту'] {
  map_id bigint [ref: > maps.id]
  tournament_player_id bigint [ref: > tournament_players.id]
  ruleset_id bigint [ref: > scoring_rulesets.id]
  raw_points numeric(7,2) [not null]
  points numeric(7,2) [not null, note: '× множитель позиции']
  breakdown jsonb [not null, note: 'очки по строкам — для «итога карты»']
  data_tier text [not null, note: 'live | basic | parsed']
  computed_at timestamptz [not null]
  indexes {
    (map_id, tournament_player_id, ruleset_id) [pk]
  }
}

Table player_stage_points [note: 'Очки игрока за стадию (сумма)'] {
  tournament_player_id bigint [ref: > tournament_players.id]
  stage_id bigint [ref: > stages.id]
  points numeric(7,2) [not null]
  maps_played smallint [not null]
  ownership_pct numeric(5,2) [note: 'доля составов с игроком']
  indexes {
    (tournament_player_id, stage_id) [pk]
  }
}

Table users [note: 'Менеджер'] {
  id bigint [pk]
  tenant_id bigint [not null, ref: > tenants.id, note: 'свой сайт = тенант по умолчанию']
  nickname text [not null]
  avatar_hue smallint
  favorite_team_id bigint [ref: > teams.id]
  locale text [not null, note: 'ru']
  role text [not null, note: 'user | admin']
  created_at timestamptz [not null]
  deleted_at timestamptz [note: 'мягкое удаление']
}

Table auth_identities [note: 'Способ входа'] {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  provider text [not null, note: 'device | telegram | email | vk']
  provider_uid text [not null]
  verified_at timestamptz
  indexes {
    (provider, provider_uid) [unique]
  }
}

Table user_sessions [note: 'Сессия'] {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  token_hash bytea [unique]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  last_seen_at timestamptz
}

Table notification_prefs [note: 'Настройки уведомлений'] {
  user_id bigint [pk, ref: > users.id]
  round_open boolean [not null]
  deadline_reminder boolean [not null, note: 'за 3 часа, если нет состава']
  round_result boolean [not null]
  replay_parsed boolean [not null, note: '«разбор реплея готов»']
  channels jsonb [not null, note: 'telegram, email, push']
}

Table lineups [note: 'Состав менеджера на турнир'] {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  tournament_id bigint [not null, ref: > tournaments.id]
  bank numeric(4,1) [not null]
  free_transfers smallint [not null, note: '0–2']
  captain_position smallint [note: '1–5']
  chip_pending text [not null, note: 'none | triple | wildcard']
  triple_used_stage_id bigint [ref: > stages.id]
  wildcard_used_stage_id bigint [ref: > stages.id]
  first_completed_at timestamptz [note: 'для равенства']
  total_points numeric(8,2) [not null, note: 'денормализовано']
  updated_at timestamptz [not null]
  indexes {
    (user_id, tournament_id) [unique]
  }
}

Table lineup_slots [note: 'Текущий черновик (то, что видно в окне)'] {
  lineup_id bigint [ref: > lineups.id]
  position smallint [note: '1–5']
  tournament_player_id bigint [not null, ref: > tournament_players.id]
  bought_price numeric(4,1) [not null]
  indexes {
    (lineup_id, position) [pk]
  }
}

Table lineup_locks [note: 'Снимок состава в дедлайн стадии'] {
  id bigint [pk]
  lineup_id bigint [not null, ref: > lineups.id]
  stage_id bigint [not null, ref: > stages.id]
  captain_tp_id bigint [not null, ref: > tournament_players.id]
  chip text [not null, note: 'none | triple | wildcard']
  free_used smallint [not null]
  paid_transfers smallint [not null]
  penalty numeric(5,1) [not null]
  locked_at timestamptz [not null]
  indexes {
    (lineup_id, stage_id) [unique]
  }
}

Table lineup_lock_slots [note: 'Игроки снимка'] {
  lock_id bigint [ref: > lineup_locks.id]
  position smallint
  tournament_player_id bigint [not null, ref: > tournament_players.id]
  price_at_lock numeric(4,1) [not null]
  indexes {
    (lock_id, position) [pk]
    (tournament_player_id)
  }
}

Table transfers [note: 'Трансферы окна (фиксируются в дедлайн)'] {
  id bigint [pk]
  lineup_id bigint [not null, ref: > lineups.id]
  stage_id bigint [not null, ref: > stages.id, note: 'стадия, перед которой окно']
  position smallint [not null]
  out_tp_id bigint [not null, ref: > tournament_players.id]
  in_tp_id bigint [not null, ref: > tournament_players.id]
  out_price numeric(4,1) [not null]
  in_price numeric(4,1) [not null]
  kind text [not null, note: 'free | paid | eliminated | guaranteed | wildcard']
}

Table lineup_stage_scores [note: 'Очки состава за стадию'] {
  lineup_id bigint [ref: > lineups.id]
  stage_id bigint [ref: > stages.id]
  points numeric(8,2) [not null, note: 'с капитаном и штрафом']
  data_tier text [not null, note: 'live | basic | parsed']
  updated_at timestamptz [not null]
  indexes {
    (lineup_id, stage_id) [pk]
  }
}

Table tournament_standings [note: 'Таблица турнира (материализована)'] {
  tournament_id bigint [ref: > tournaments.id]
  lineup_id bigint [ref: > lineups.id]
  total_points numeric(8,2) [not null]
  rank integer [not null]
  prev_rank integer [note: 'стрелка ↑↓']
  tiebreak jsonb [not null, note: 'платные трансферы, очки последней стадии, время']
  is_final boolean [not null, note: 'места окончательные после разбора всех карт']
  updated_at timestamptz [not null]
  indexes {
    (tournament_id, lineup_id) [pk]
    (tournament_id, rank)
  }
}

Table mini_leagues [note: 'Мини-лига'] {
  id bigint [pk]
  code text [unique, note: 'SLM9-K7QX']
  name text [not null]
  owner_user_id bigint [not null, ref: > users.id]
  scope text [not null, note: 'tournament | season']
  tournament_id bigint [ref: > tournaments.id]
  season_id bigint [ref: > seasons.id]
  created_at timestamptz [not null]
}

Table mini_league_members [note: 'Участник мини-лиги'] {
  mini_league_id bigint [ref: > mini_leagues.id]
  user_id bigint [ref: > users.id]
  joined_at timestamptz [not null]
  indexes {
    (mini_league_id, user_id) [pk]
  }
}

Table pickem_questions [note: 'Вопрос'] {
  id bigint [pk]
  tournament_id bigint [not null, ref: > tournaments.id]
  stage_id bigint [not null, ref: > stages.id]
  series_id bigint [ref: > series.id, note: 'для вопросов «кто выиграет серию»']
  kind text [not null, note: 'series | two_of | one_of']
  title text [not null]
  options jsonb [not null, note: 'team_id вариантов']
  max_points smallint [not null]
  closes_at timestamptz [not null, note: 'дедлайн стадии или старт серии']
  correct jsonb [note: 'заполняется после итога']
  resolved_at timestamptz
}

Table pickem_answers [note: 'Ответ менеджера'] {
  question_id bigint [ref: > pickem_questions.id]
  user_id bigint [ref: > users.id]
  answer jsonb [not null, note: '{w, sc} | {set} | {w}']
  points smallint [note: 'после итога']
  updated_at timestamptz [not null]
  indexes {
    (question_id, user_id) [pk]
  }
}

Table pickem_results [note: 'Итог прогнозов за турнир'] {
  tournament_id bigint [ref: > tournaments.id]
  user_id bigint [ref: > users.id]
  points smallint [not null]
  max_points smallint [not null]
  medal text [note: 'bronze | silver | gold | platinum']
  updated_at timestamptz [not null]
  indexes {
    (tournament_id, user_id) [pk]
  }
}

Table league_tiers [note: 'Лиги (справочник)'] {
  id smallint [pk, note: '1 Рекрут … 8 Титан']
  code text [unique, note: 'herald…immortal']
  name_ru text [not null]
}

Table season_ladders [note: 'Какие лиги активны в сезоне'] {
  season_id bigint [ref: > seasons.id]
  tier_id smallint [ref: > league_tiers.id]
  is_active boolean [not null, note: 'фазы 1–3 по аудитории']
  indexes {
    (season_id, tier_id) [pk]
  }
}

Table league_memberships [note: 'Лига менеджера в сезоне'] {
  season_id bigint [ref: > seasons.id]
  user_id bigint [ref: > users.id]
  tier_id smallint [ref: > league_tiers.id, note: 'null — калибровка']
  skip_streak smallint [not null]
  best_tier_id smallint [ref: > league_tiers.id]
  calibrated_at timestamptz
  indexes {
    (season_id, user_id) [pk]
  }
}

Table league_rounds [note: 'Раунд лиги = турнир'] {
  id bigint [pk]
  season_id bigint [not null, ref: > seasons.id]
  tournament_id bigint [unique, ref: > tournaments.id]
  round_no smallint [not null]
  status text [not null, note: 'upcoming | grouped | settled']
  groups_formed_at timestamptz
  settled_at timestamptz
}

Table league_groups [note: 'Группа раунда'] {
  id bigint [pk]
  round_id bigint [not null, ref: > league_rounds.id]
  tier_id smallint [not null, ref: > league_tiers.id]
  group_no smallint [not null]
  pooled_key text [note: 'сводная таблица нескольких лиг']
  zone_up smallint [not null, note: 'мест в зоне повышения']
  zone_down smallint [not null]
}

Table league_group_members [note: 'Менеджер в группе'] {
  group_id bigint [ref: > league_groups.id]
  user_id bigint [ref: > users.id]
  round_id bigint [not null, ref: > league_rounds.id, note: 'для UNIQUE']
  lineup_id bigint [not null, ref: > lineups.id]
  tier_at_start smallint [not null, ref: > league_tiers.id]
  place smallint
  zone text [note: 'up | stay | down']
  tier_after smallint [ref: > league_tiers.id]
  indexes {
    (group_id, user_id) [pk]
    (round_id, user_id) [unique]
  }
}

Table titan_round_points [note: 'Очки F1 Титанов за раунд'] {
  round_id bigint [ref: > league_rounds.id]
  user_id bigint [ref: > users.id]
  season_id bigint [not null, ref: > seasons.id]
  place smallint [not null]
  f1_points smallint [not null, note: '25, 18, 15…']
  indexes {
    (round_id, user_id) [pk]
  }
}

Table season_titles [note: 'Титулы сезона'] {
  id bigint [pk]
  season_id bigint [not null, ref: > seasons.id]
  user_id bigint [not null, ref: > users.id]
  title text [not null, note: 'best_regular | champion | best_tier']
  tier_id smallint [ref: > league_tiers.id]
  awarded_at timestamptz [not null]
}

Table achievements [note: 'Достижение (справочник)'] {
  id bigint [pk]
  code text [unique]
  name_ru text [not null]
  category text [not null]
  tiers jsonb [note: 'пороги уровней']
}

Table user_achievements [note: 'Полученное достижение'] {
  user_id bigint [ref: > users.id]
  achievement_id bigint [ref: > achievements.id]
  tier smallint [not null]
  earned_at timestamptz [not null]
  context jsonb [note: 'турнир, игрок, карта']
  indexes {
    (user_id, achievement_id) [pk]
  }
}

Table trophies [note: 'Трофей'] {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  kind text [not null, note: 'promotion | group_first | best_stage | pickem_medal']
  tournament_id bigint [ref: > tournaments.id]
  season_id bigint [ref: > seasons.id]
  label text [not null]
  awarded_at timestamptz [not null]
}

Table notifications [note: 'Уведомление'] {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  kind text [not null]
  payload jsonb [not null]
  channel text [not null, note: 'telegram | email | push | inapp']
  created_at timestamptz [not null]
  sent_at timestamptz
  read_at timestamptz
}

Table tenants [note: 'Тенант (бренд)'] {
  id bigint [pk]
  slug text [unique, note: 'default, partner-x']
  name text [not null]
  branding jsonb [note: 'цвета, шрифты, домен']
  is_default boolean [not null]
}

Table api_clients [note: 'Ключ API партнёра'] {
  id bigint [pk]
  tenant_id bigint [not null, ref: > tenants.id]
  name text [not null]
  key_hash bytea [unique]
  scopes "text[]" [not null, note: 'read:tournaments, read:standings…']
  rate_limit_per_min integer [not null]
  revoked_at timestamptz
}

Table webhook_subscriptions [note: 'Подписка на события'] {
  id bigint [pk]
  api_client_id bigint [not null, ref: > api_clients.id]
  url text [not null]
  events "text[]" [not null, note: 'map.scored, stage.locked, stage.settled']
  secret_hash bytea [not null, note: 'подпись запросов']
  is_active boolean [not null]
}

Table webhook_deliveries [note: 'Доставка вебхука'] {
  id bigint [pk]
  subscription_id bigint [not null, ref: > webhook_subscriptions.id]
  event text [not null]
  payload jsonb [not null]
  status text [not null, note: 'pending | delivered | failed']
  attempts smallint [not null]
  next_attempt_at timestamptz
  delivered_at timestamptz
}
